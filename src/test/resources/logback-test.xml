<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Same layout as production so unit-test logs show the trace id too. -->
    <property name="PATTERN"
              value="%d{HH:mm:ss.SSS} %-5level [%thread] traceId=%X{traceId:-} %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="com.github.highcumontoa" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
